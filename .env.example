MONGODB_URI=mongodb://127.0.0.1:27017/platform
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: share cookie across subdomains (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# Cross-app URLs (server-side)
GROWTHHUB_URL=http://localhost:4000
CAREERFLOW_URL=http://localhost:3000
CAREERFLOW_API_URL=http://localhost:8000

# Cross-app URLs (browser — required for sidebar / login links)
NEXT_PUBLIC_CAREERFLOW_URL=http://localhost:3000

# Google OAuth is handled by CareerFlow API (shared)
# Configure GOOGLE_* in CareerFlow backend/.env

# Auth rate limiting — on by default in production; off in development
# RATE_LIMIT_ENABLED=false
# AUTH_RATE_LIMIT_ENABLED=false

# Guest demo login — disabled in production unless explicitly enabled
# ALLOW_GUEST_AUTH=false
