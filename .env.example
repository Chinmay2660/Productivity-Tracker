# GrowthHub — copy to .env.local for local development
# cp .env.example .env.local

# ── Shared platform auth (MUST match CareerFlow backend/.env) ─────────────────
# Same database + session secret = one login for GrowthHub + CareerFlow
MONGODB_URI=mongodb://127.0.0.1:27017/platform
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/platform?retryWrites=true&w=majority
SESSION_SECRET=change-me-to-a-long-random-string
# Generate: openssl rand -hex 32

# Optional: share cookies across subdomains in production (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com

# ── Cross-app URLs (local dev) ──────────────────────────────────────────────
GROWTHHUB_URL=http://localhost:4000
CAREERFLOW_URL=http://localhost:3000
CAREERFLOW_API_URL=http://localhost:8000

# Browser-visible — sidebar / login links to CareerFlow
NEXT_PUBLIC_CAREERFLOW_URL=http://localhost:3000

# ── Configured elsewhere ──────────────────────────────────────────────────────
# Google OAuth: CareerFlow backend/.env (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
# JWT: not used by GrowthHub (CareerFlow backend only)

# ── Optional ─────────────────────────────────────────────────────────────────
# Auth rate limiting — on in production by default; off in development
# RATE_LIMIT_ENABLED=false
# AUTH_RATE_LIMIT_ENABLED=false

# Guest demo login — disabled in production unless explicitly enabled
# ALLOW_GUEST_AUTH=false
